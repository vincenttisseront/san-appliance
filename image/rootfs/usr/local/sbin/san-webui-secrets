#!/bin/sh
# First-boot secrets live on san-data. They are not part of the root image.
set -eu

install -d -o sanui -g sanui -m 0750 /var/lib/san/webui
env=/var/lib/san/webui/webui.env
if [ -f "$env" ]; then
    chown sanui:sanui "$env"
    chmod 0640 "$env"
    exit 0
fi

jwt=$(/usr/bin/node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
key=$(/usr/bin/node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
umask 077
cat > "$env" << EOF
NUXT_JWT_SECRET=${jwt}
NUXT_ENCRYPTION_KEY=${key}
EOF
chown sanui:sanui "$env"
chmod 0640 "$env"
