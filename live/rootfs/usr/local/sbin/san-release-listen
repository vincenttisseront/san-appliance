#!/usr/bin/env python3
"""Écoute 127.0.0.1:9753 et applique une release. Ne tourne pas sur l'hôte de build."""
import os
import sys
from pathlib import Path

lib = Path("/usr/lib/san-tui")
if lib.is_dir():
    sys.path.insert(0, str(lib))

from san_tui.paths import SanPaths
from san_tui.release import serve

if __name__ == "__main__":
    os.umask(0o077)
    serve(SanPaths(None), token_file=os.environ.get("SAN_GITHUB_TOKEN_FILE", "/etc/san/github.token"))
