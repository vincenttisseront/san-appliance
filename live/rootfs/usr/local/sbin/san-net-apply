#!/usr/bin/python3
"""Pose les adresses admin et stockage si le support de conf a été accepté.

L'agrégat et le MTU 9000 sont décidés tout seuls. S'ils échouent, l'adresse
de stockage est quand même posée : iSCSI peut démarrer.
"""

import json
import sys
from pathlib import Path

LIB = Path("/usr/lib/san-tui")
if LIB.is_dir():
    sys.path.insert(0, str(LIB))


def main():
    state_path = Path("/run/san/medium-state.json")
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        print("san-net-apply: support non confirmé")
        return
    if not state.get("ok"):
        print("san-net-apply: {}".format(state.get("reason") or "support refusé"))
        return
    doc_path = Path("/var/lib/san/conf/exports.json")
    if not doc_path.is_file():
        return
    document = json.loads(doc_path.read_text(encoding="utf-8"))
    network = document.get("network") or {}
    admin = (network.get("admin") or {}).get("iface")
    storage = (network.get("storage") or {}).get("iface")
    if not admin or not storage or admin == storage:
        print("san-net-apply: interfaces admin et stockage non distinctes")
        return
    if _comfort(network):
        return
    _plain(network)


def _comfort(network):
    try:
        from san_tui.auto import undone
        from san_tui.link import CommandRunner, configure_links
        from san_tui.paths import SanPaths
        from san_tui.probe import CommandProbe
    except Exception as exc:
        print("san-net-apply: confort indisponible : {}".format(exc.__class__.__name__))
        return False
    paths = SanPaths("/")
    try:
        result = configure_links(
            network,
            CommandRunner(),
            CommandProbe().list_interfaces(),
            bond=not undone(paths, "bond"),
            jumbo=not undone(paths, "mtu"),
        )
    except Exception as exc:
        print("san-net-apply: confort ignoré : {}".format(exc.__class__.__name__))
        return False
    print("san-net-apply: {}".format(json.dumps(result, ensure_ascii=False)))
    return bool(result.get("storage"))


def _plain(network):
    import subprocess
    import time
    for role in ("admin", "storage"):
        item = network.get(role) or {}
        iface = item.get("iface") or ""
        address = item.get("address") or ""
        if not iface or not address:
            continue
        deadline = time.time() + 20
        sysfs = Path("/sys/class/net") / iface
        while time.time() < deadline and not sysfs.exists():
            time.sleep(1)
        if not sysfs.exists():
            print("san-net-apply: interface absente {}".format(iface))
            continue
        subprocess.run(["ip", "link", "set", iface, "up"], check=False)
        subprocess.run(["ip", "link", "set", iface, "mtu", "1500"], check=False)
        subprocess.run(["ip", "addr", "replace", address, "dev", iface], check=False)
        print("san-net-apply: {} {} dev {}".format(role, address, iface))


if __name__ == "__main__":
    main()
