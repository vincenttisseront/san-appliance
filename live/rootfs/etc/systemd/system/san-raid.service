[Unit]
Description=Assemble les arrays mdadm enregistrés
After=san-conf-bind.service san-net-apply.service
Before=san-restore.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/san-raid
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
