#!/usr/bin/env python3
import os
import sys
from pathlib import Path

lib = Path("/usr/lib/san-tui")
if lib.is_dir():
    sys.path.insert(0, str(lib))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from san_tui.cli import main

if __name__ == "__main__":
    os.umask(0o077)
    sys.exit(main())
